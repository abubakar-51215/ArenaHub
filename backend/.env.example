# ArenaHub backend settings. Copy to .env (gitignored) and fill in. Names only here: no real values.
# Every setting below is read by backend/app/core/config.py; nothing else in the app reads the
# environment. "Secret" means a long random string (32+ characters) kept out of the repository, for
# example from: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Outside development (ENVIRONMENT=staging or prod) the server refuses to start with a missing,
# short or default secret, DEBUG on, PAYMENT_MODE=mock, a wildcard host or origin, or (prod) a
# non-https origin. It names the problem and never prints a value.

# --- Core ---
# Required on every server: dev | staging | prod. Not set = dev (development behaviour: codes in the
# log, interactive docs, mock helpers). scripts/security-check.py warns when it is not set.
ENVIRONMENT=
# Optional: DEBUG | INFO | WARNING | ERROR (default INFO).
LOG_LEVEL=
# Optional: true only on a developer machine; must be off outside development (default false).
DEBUG=

# --- Database ---
# Required: postgresql+asyncpg://<user>:<password>@<host>:5432/<database>. Tests use "<database>_test"
# (tests/conftest.py derives it), never this database.
DATABASE_URL=
# Optional, tests only: point the test suite at another database.
TEST_DATABASE_URL=

# --- Redis (Memurai on Windows) ---
# Required outside development: redis://[:<password>@]<host>:6379/0 (rate limits, session cut-offs,
# locks). Never reachable from the internet. Default redis://localhost:6379/0.
REDIS_URL=

# --- Sign-in tokens ---
# Required secrets outside development: two DIFFERENT long random strings (32+ bytes each).
JWT_SECRET=
JWT_REFRESH_SECRET=
# Required secret outside development: key for the HMAC of emailed 6-digit codes, and the root of
# the key that signs private receipt links (/api/v1/media/receipts/...). Changing it voids codes
# and receipt links in flight. There is no separate FILE_URL_SECRET.
CODE_HASH_SECRET=

# --- Addresses and hosts ---
# Required in prod: the exact host names the API answers to, comma-separated, no wildcard.
ALLOWED_HOSTS=
# Required outside development: exact web origins allowed to call the API, comma-separated,
# https:// in prod, no wildcard. Development uses a fixed localhost list and ignores this.
CORS_ALLOWED_ORIGINS=
# Optional: addresses or ranges of your own proxies / load balancers allowed to pass the client
# address in X-Forwarded-For, comma-separated. Empty = the header is ignored. Decided at go-live.
TRUSTED_PROXIES=
# Required outside development: where the web app is served (links and the logo in emails).
# Default http://localhost:3000.
WEB_PUBLIC_URL=
# Required outside development: the public https address of this API (the card payment page sends
# the player back to the app through it). Default http://localhost:8000. Decided at go-live.
API_PUBLIC_URL=

# --- Rate limits (optional) ---
# Requests per minute per address: sign-in routes (default 20) and the rest of the API (default 100).
# Leave empty on servers; a developer may raise them locally for manual testing only.
RATE_LIMIT_AUTH_PER_MINUTE=
RATE_LIMIT_API_PER_MINUTE=

# --- Pictures ---
# Optional: folder for uploaded pictures kept on this server's disk (default uploads) and the
# address they are served under (default /uploads). Receipts are never served from there.
MEDIA_ROOT=
MEDIA_URL_PREFIX=
# Optional secret: cloudinary://<api_key>:<api_secret>@<cloud_name>. Remote storage is NOT built
# yet (go-live blocker, see docs/BEFORE_GOING_LIVE.md).
CLOUDINARY_URL=

# --- Payments ---
# Optional: auto (default; real providers, which simulate in development without credentials) or
# mock (development and tests only; refused outside development).
PAYMENT_MODE=
# Optional secrets: card payments (Stripe). Empty = card payments are "not available yet".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: JazzCash and EasyPaisa merchant settings. The two webhook secrets are long random
# strings shared with the provider; empty = their callbacks are refused.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_WEBHOOK_SECRET=
EASYPAISA_MERCHANT_ID=
EASYPAISA_WEBHOOK_SECRET=

# --- Email (codes and notices) ---
# Required outside development for real delivery: the SMTP server, port (587 STARTTLS or 465 SSL),
# user, password (a secret; for Gmail an App Password) and the From line.
# Check them without the app: uv run python scripts/send_test_email.py <your address>
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
# Optional, development only: 1 to really send from a dev machine (default 0 = log only).
EMAIL_SEND_IN_DEV=
# Optional: the support address named in the owner login-alert email, and nowhere else.
# Default support.arenahub@gmail.com (temporary, see docs/BEFORE_GOING_LIVE.md).
SUPPORT_EMAIL=

# --- Continue with Google (players on the phone) ---
# Optional: the OAuth client ids a Google ID token may be issued for, comma-separated (Web, Android,
# iOS). Empty = Google sign-in is off ("not available yet"). Decided at go-live.
GOOGLE_CLIENT_IDS=
