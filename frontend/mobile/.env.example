# ArenaHub phone app. Copy to .env (gitignored) and fill in.
# EXPO_PUBLIC_* values are built into the app, so they are public: never put a secret here.

# Required: the backend address, no trailing slash and no /api/v1. Development: http://localhost:8000
# (simulator / web) or your computer's LAN address (a physical phone, e.g. http://192.168.1.5:8000).
# A release build needs an https address; a plain http one is never used outside development builds.
# Empty = http://localhost:8000 in development.
EXPO_PUBLIC_API_URL=

# Optional (Continue with Google, players). Works only in a development or store build, never in
# Expo Go. Empty until the Google Cloud project exists (docs/BEFORE_GOING_LIVE.md); the button then
# says "Google sign-in is not available yet." The Web client id is also the server's audience
# (backend GOOGLE_CLIENT_IDS).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional, iOS builds only: the reversed iOS client id, read by app.config.js (build time).
GOOGLE_IOS_URL_SCHEME=
