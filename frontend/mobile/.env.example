# FastAPI backend base URL (no trailing slash, no /api/v1 suffix).
# Simulator / web: http://localhost:8000
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.5:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Continue with Google (players). Works only in a development or store build, never in Expo Go. Leave empty until
# the Google Cloud project exists (docs/BEFORE_GOING_LIVE.md, "Decide at the very end"); the button then says
# "Google sign-in is not available yet." The Web client id is also the server's audience (GOOGLE_CLIENT_IDS).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# For the iOS build only: the reversed iOS client id, given to the config plugin by app.config.js.
# GOOGLE_IOS_URL_SCHEME=
