# ArenaHub web (owner and admin dashboards). Copy to .env.local (gitignored) and fill in.
# NEXT_PUBLIC_* values are built into the pages, so they are public: never put a secret here.

# Required: the backend address, no trailing slash and no /api/v1 (development: http://localhost:8000;
# production: the https address of the API). Empty = the API is called on the same site (/api/v1).
NEXT_PUBLIC_API_URL=

# Required outside development: the public https address of this web app (share cards and icons).
# Empty = http://localhost:3000. Decided at go-live (docs/BEFORE_GOING_LIVE.md).
NEXT_PUBLIC_SITE_URL=

# Optional: map tile address. Empty = https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_URL=

# Optional: Sentry error tracking for the web app. Empty = off (no init, no network call).
# The web project's DSN from sentry.io (public; events are scrubbed of personal data first).
NEXT_PUBLIC_SENTRY_DSN=
